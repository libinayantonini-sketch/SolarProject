# Copie para .env e preencha. Nunca suba o .env para o Git.

# --- Banco ---
POSTGRES_PASSWORD=troque-esta-senha
# Fora do docker-compose: DATABASE_URL=postgresql+psycopg://soiling:SENHA@localhost:5432/soiling

# --- ESP32 (rede local) ---
# IP que o Monitor Serial mostra no boot. Para testar sem hardware, use o simulador: http://simulador:8081 (compose --profile sim)
ESP32_URL=http://192.168.0.50
ESP32_KEY=
# Tamanho (lado, em px) e classes do modelo do ESP32. Têm que ser IGUAIS ao treino e ao firmware.
ESP32_INPUT_SIZE=96
# LIMPO,MODERADO,SEVERO (padrão) ou LIMPO,SEVERO se o modelo do ESP32 passar a ter 2 classes
ESP32_CLASSES=LIMPO,MODERADO,SEVERO

# --- Modelo grande no servidor (opcional; veja docs/12_MODELO_NO_SERVIDOR.md) ---
# Pasta com model.onnx, labels.json e model_card.json. Vazia/ausente = só o modo ESP32 fica disponível.
SERVER_MODEL_DIR=models/server
# Tamanho de entrada do modelo grande. 0 = usar o "input_size" do model_card.json
SERVER_INPUT_SIZE=0
# Maior lado (px) da foto enviada pelo front; o backend gera o tamanho exato de cada modelo a partir dela
UPLOAD_MAX_SIDE=512

# --- Segurança ---
# Protege: acionar a bomba, corrigir rótulo, apagar. Vazio = sem proteção (só para teste local).
ADMIN_API_KEY=troque-esta-chave

# --- Gemini (opcional; precisa de internet) ---
GEMINI_API_KEY=
# Nome do modelo: confira em https://ai.google.dev/gemini-api/docs/models (os nomes mudam; não há padrão de propósito)
GEMINI_MODEL=

# --- Recomendação de chuva (Open-Meteo; só informa, nunca aciona a bomba; precisa de internet) ---
WEATHER_ENABLED=1
# Posição do painel (padrão: Londrina-PR; troque pela posição real)
PANEL_LAT=-23.3103
PANEL_LON=-51.1628
# Limiares PROVISÓRIOS (mm de chuva prevista em 24 h): calibre observando o painel
RAIN_LIGHT_MM=1.0
RAIN_HEAVY_MM=10.0
